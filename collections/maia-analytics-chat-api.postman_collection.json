          "id": "8d51e549-54ff-4759-a18f-9721ae7d6c3d",
          "name": "Resume Chat Main Agent",
          "request": {
            "name": "Resume Chat Main Agent",
            "description": {
              "content": "Re-attach to a project's in-flight chat run after a mid-stream refresh.\n\nRead-only second reader: tails the existing workflow's durable stream\n(``read_stream`` replays from offset 0 → the full ordered sequence: the\nuser-message echo, every delta so far, then the terminal) WITHOUT starting\na run or claiming a slot. If no run is live the generator yields nothing; the\nFE then sees no terminal and falls back to reloading persisted history (the\nempty replay is the signal that the run finished and released its slot before\nthis reattach).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
