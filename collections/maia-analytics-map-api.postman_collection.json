        {
          "id": "567c9d2a-dc25-492d-8432-424235484a67",
          "name": "Get Layer Mvt Agg Tile",
          "request": {
            "name": "Get Layer Mvt Agg Tile",
            "description": {
              "content": "Serve an aggregate (bin-count) MVT tile for low-zoom rendering.\n\nEmits one MVT point per occupied grid cell with a ``count`` property —\nthe client renders bubbles sized by count at zoom levels below the\ndetail-layer threshold so panning over dense data doesn't tessellate\ntens of thousands of features the user can't actually see.\n\n``filter_id`` — same as detail tiles; the aggregate counts then reflect\nthe active filter instead of the layer total. Favorites-only resolution\nmatches ``get_layer_mvt_tile`` so agg bubbles count only the favorites\nwhen that toggle is on.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "map",
                ":layer_id",
                "agg-tiles",
                ":z",
                ":x",
                "{{y}}.pbf"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "v",
