                "value": "",
                "type": "query"
              },
              {
                "name": "geometry",
                "value": "",
                "type": "query"
              },
              {
                "name": "favoritesOnly",
                "value": "",
                "type": "query"
              },
              {
                "name": "token",
                "value": "",
                "type": "query",
                "description": "Firebase ID token for MVT authentication"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
